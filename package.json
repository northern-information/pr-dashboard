{
  "name": "@northern-information/pr-dashboard",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public"
  },
  "description": "Live terminal dashboard for GitHub PRs — fresher than the web UI, two-tier polling, scoped by org",
  "type": "module",
  "bin": {
    "prd": "bin/prd"
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "github",
    "pull-requests",
    "prs",
    "dashboard",
    "tui",
    "ink",
    "cli",
    "gh"
  ],
  "homepage": "https://github.com/northern-information/pr-dashboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/northern-information/pr-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/northern-information/pr-dashboard/issues"
  },
  "license": "MIT",
  "author": "Tyler Etters",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.tsx",
    "start": "tsx src/main.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "ink": "8.0.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "19.3.1",
    "tsx": "4.23.15",
    "update-notifier": "7.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/update-notifier": "6.0.9",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
